# ----------------------------------------------------------------------------
# main.tf
#
# The resources for the Terraform state bucket. Each block below explains what
# it creates and why it is needed. Read them top to bottom.
#
# Terraform builds these in dependency order automatically: the bucket first,
# then the settings that attach to it.
#
# WHAT STATE LOCKING IS (and why every team needs it)
# Terraform reads the state, makes a plan, changes resources, then writes the new state.
# If two people or two pipeline runs do this on the same stack at the same time, they
# both read the old state and the second write overwrites the first. The result is state
# that no longer matches AWS, and the next apply can delete or duplicate resources.
#
# A lock stops that. Before Terraform touches the state, it takes a lock. A second run
# sees the lock and waits or fails with "state is locked", instead of corrupting state.
#
# EXAMPLE:
#   10:00  Alice runs `terraform apply` on dev        -> takes the lock
#   10:01  Pipeline run starts for the same dev stack -> "Error: Error acquiring the state lock"
#   10:05  Alice's apply finishes, lock released      -> pipeline run can now go ahead
#
# HOW IT IS DONE HERE
# We use S3 native locking. Terraform writes a small file named <stack>.tflock next to the
# state file while it runs. The other stacks turn it on with `use_lockfile = true`.
# If a run crashes and leaves a stale lock, `terraform force-unlock <LOCK_ID>` removes it,
# but only after you have confirmed no other run is active.
#
# WHY ENCRYPT STATE SPECIFICALLY
# A Terraform state file records the full detail of every resource, including
# values that are sensitive. Terraform does not hide them in state, so the file
# can contain:
#   - database passwords (when set or generated by Terraform)
#   - private keys and certificates created by Terraform
#   - connection strings, IP addresses, and account IDs
#
# Example of a state entry (simplified):
#   "resource": "aws_db_instance.main",
#   "attributes": { "username": "admin", "password": "Sup3rSecret!", "endpoint": "db.example.internal" }
#
# Anyone who can read that file can read the password, even if they never touch the
# database. So state gets the same protection as a password file:
#   - encryption at rest (KMS), so a copied file is unreadable
#   - HTTPS only, so it can't be sniffed on the network
#   - no public access, and access only for the people and pipelines that need it
#
# Rule: never store secrets in code or in .tfvars files. Store them in AWS Secrets
# Manager and reference them. Even then, state can hold copies, so protect it.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# DATA SOURCE: who am I?
# A "data" block reads information from AWS. It creates nothing.
# Used here only to print the account ID in outputs.tf.
# ----------------------------------------------------------------------------
data "aws_caller_identity" "current" {}

# ----------------------------------------------------------------------------
# THE BUCKET: holds the Terraform state files for every stack.
#
# Why: Terraform records what it created in a "state" file. If that file is
# only on one laptop, teammates can't work together, and losing it means losing
# track of the infrastructure. S3 keeps it shared and durable.
# ----------------------------------------------------------------------------
resource "aws_s3_bucket" "tfstate" {
  bucket = var.state_bucket_name

  # Stops `terraform destroy` from deleting this bucket. Deleting it would lose
  # the state of every stack. To remove it on purpose, you must edit this line first.
  lifecycle {
    prevent_destroy = true
  }
}

# ----------------------------------------------------------------------------
# VERSIONING: keep every old copy of every state file.
#
# Why: if an apply goes wrong and corrupts state, you can restore the previous
# version from S3 instead of rebuilding infrastructure by hand.
# ----------------------------------------------------------------------------
resource "aws_s3_bucket_versioning" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id

  versioning_configuration {
    status = "Enabled"
  }
}

# ----------------------------------------------------------------------------
# KMS KEY: the encryption key that protects the state.
#
# Why: state can contain resource IDs and, in some cases, secret values. Encrypting
# it with a key we control means the data is unreadable without permission to use
# that key, and we can audit every use in CloudTrail.
#
# KMS protects READING, not DELETING. Each job has its own protection:
#   Reading state    -> KMS key policy + IAM (only allowed users can decrypt)
#   Deleting state   -> S3 versioning (old copies survive), prevent_destroy (Terraform
#                       refuses to remove the bucket), and IAM rules on who can delete
#
# GRANULARITY: one KMS key encrypts the whole bucket, so KMS cannot tell files apart.
#   File-level access -> S3 permissions (IAM policies, prefixes like dev/ and prod/)
#   Key-level access  -> kms:Decrypt on this key (all-or-nothing for the bucket)
#   For full separation per environment, use one KMS key per environment.
#
# WHAT A USER NEEDS TO READ STATE (example IAM policy, for a human or a pipeline role):
#   {
#     "Effect": "Allow",
#     "Action": ["s3:ListBucket"],
#     "Resource": "arn:aws:s3:::<state-bucket>"
#   },
#   {
#     "Effect": "Allow",
#     "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
#     "Resource": "arn:aws:s3:::<state-bucket>/dev/*"
#   },
#   {
#     "Effect": "Allow",
#     "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
#     "Resource": "<kms-key-arn>"
#   }
#   Reads need GetObject and Decrypt. Writes and locks need PutObject, DeleteObject,
#   and GenerateDataKey as well.
#
#   Deleting the key -> deletion_window_in_days (AWS waits 7 days, you can cancel).
#                       If the key is really deleted, the state is gone for good,
#                       even though the files still exist. So the key needs protection too.
# ----------------------------------------------------------------------------
resource "aws_kms_key" "tfstate" {
  description = "Encrypts Terraform state for us-staffing"

  # AWS rotates the key material once a year automatically. Old data still decrypts.
  enable_key_rotation = true

  # If the key is scheduled for deletion, AWS waits this many days before deleting it.
  # Gives you time to cancel by mistake. Minimum is 7.
  deletion_window_in_days = 7
}

# ----------------------------------------------------------------------------
# KMS ALIAS: a friendly name for the key.
#
# Why: the key itself has a random ID. An alias such as alias/us-staffing-tfstate
# is easier to read in the console and in code.
#
# EXAMPLE (think of it like a contact name in your phone):
#   Key ID (the phone number):  1a2b3c4d-....-9f8e   <- hard to remember
#   Alias  (the contact name):  alias/us-staffing-tfstate <- easy to remember
#   A key can be renamed or replaced, and the alias can be moved to the new key
#   without changing any code that uses the alias.
# ----------------------------------------------------------------------------
resource "aws_kms_alias" "tfstate" {
  name          = "alias/us-staffing-tfstate"
  target_key_id = aws_kms_key.tfstate.key_id
}

# ----------------------------------------------------------------------------
# ENCRYPTION AT REST: encrypt every object in the bucket with the KMS key.
#
# Why: without this, objects are encrypted with a default AWS-managed key that we
# don't control. This makes our key the one that is used for every object.
# bucket_key_enabled reduces the number of KMS requests (and their cost).
#
# EXAMPLE: "encryption at rest" means data is scrambled while it sits on disk.
#   Without encryption, the file on AWS's disk looks like this (readable to anyone
#   who gets hold of the disk, or to an attacker who gets a copy of the bucket):
#     {"resources":[{"type":"aws_db_instance","instances":[{"attributes":{"password":"Sup3rSecret"}}]}]}
#
#   With encryption, the same file on disk looks like this:
#     x7Qz9!mKp2...@#LkR8...   <- unreadable without the KMS key
#
#   To read it, a request must first be allowed to use the KMS key. So:
#     1. Stolen disk or leaked copy        -> unreadable, no key
#     2. Someone with S3 access but no key -> "AccessDenied" from KMS
#     3. Your pipeline or your login       -> allowed, because the key policy says so
#   Every key use is also logged in CloudTrail, so you can see who read the state.
#
# Analogy: a locked filing cabinet (S3) with documents shredded into code (encryption),
# and the key that un-shreds them (KMS) kept on a separate keyring that only some people hold.
# ----------------------------------------------------------------------------
resource "aws_s3_bucket_server_side_encryption_configuration" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm     = "aws:kms"
      kms_master_key_id = aws_kms_key.tfstate.arn
    }
    bucket_key_enabled = true
  }
}

# ----------------------------------------------------------------------------
# PUBLIC ACCESS BLOCK: refuse all public access to this bucket.
#
# Why: state must never be public. This switches off every way of making it public,
# even if someone later adds a permissive policy by mistake.
# ----------------------------------------------------------------------------
resource "aws_s3_bucket_public_access_block" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id

  block_public_acls       = true # Reject new public ACLs.
  block_public_policy     = true # Reject new policies that grant public access.
  ignore_public_acls      = true # Ignore any existing public ACLs.
  restrict_public_buckets = true # Only AWS services and the account itself can access it.
}

# ----------------------------------------------------------------------------
# OBJECT OWNERSHIP: the bucket owner owns every object.
#
# Why: without this, another AWS account could upload an object that the bucket
# owner does not fully control. BucketOwnerEnforced disables per-object ACLs
# so ownership is always clear.
# ----------------------------------------------------------------------------
resource "aws_s3_bucket_ownership_controls" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

# ----------------------------------------------------------------------------
# BUCKET POLICY DOCUMENT: rules for who can access the bucket.
#
# This statement DENIES any request that does not use HTTPS.
#
# Why: without HTTPS, state could travel across the network unencrypted.
# A Deny statement always wins over an Allow, so no other policy can bypass it.
# ----------------------------------------------------------------------------
data "aws_iam_policy_document" "tfstate" {
  statement {
    sid    = "DenyInsecureTransport"
    effect = "Deny"

    # "*" means everyone. The condition below narrows it to non-HTTPS requests.
    principals {
      type        = "*"
      identifiers = ["*"]
    }

    # s3:* covers every action. Both the bucket and its objects are covered.
    actions   = ["s3:*"]
    resources = [aws_s3_bucket.tfstate.arn, "${aws_s3_bucket.tfstate.arn}/*"]

    # Only applies when the request did not use TLS (aws:SecureTransport is false).
    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }
}

# ----------------------------------------------------------------------------
# BUCKET POLICY: attaches the policy document above to the bucket.
#
# depends_on makes Terraform apply the public access block first, so the policy
# is never added while the bucket is still exposed.
# ----------------------------------------------------------------------------
resource "aws_s3_bucket_policy" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id
  policy = data.aws_iam_policy_document.tfstate.json

  depends_on = [aws_s3_bucket_public_access_block.tfstate]
}
